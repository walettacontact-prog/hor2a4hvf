<!DOCTYPE html>
<html lang="tr">

<head>
<%- include('partials/head') %>
<%- include('partials/sayfa-stil') %>
</head>

<body>
<%- include('partials/header') %>
        <!-- content begin -->
        <div class="no-bottom no-top" id="content">
            <div id="top"></div>
<%- include('partials/subheader', { arkaplan: '/static/images/background/4.webp', rozet: 'Hizmetlerimiz', h1: page.h1, crumbs: page.crumbs }) %>

            <section class="bg-light">
                <div class="container">
                    <div class="row justify-content-center mb-4">
                        <div class="col-lg-9 text-center">
                            <p class="lead mb-0">Bahçelievler Hürriyet Mahallesi’ndeki ekibimizle ev ve iş yerlerinde klima montajı, klima arıza tamiri, klima bakımı, gaz dolumu, VRF/multi sistem servisi, kombi bakımı ve kombi arıza onarımı yapıyoruz. Bir hizmeti seçerek ayrıntılarını okuyabilir ya da hemen arayabilirsiniz.</p>
                        </div>
                    </div>
                    <div class="row g-4 justify-content-center">
                        <% hizmetler.forEach(function(hizmet) { %>
                        <div class="col-lg-4 col-md-6 wow fadeInRight" data-wow-delay="0s">
                            <div class="overflow-hidden rounded-5">
                                <a href="/<%= hizmet.slug %>" class="relative d-block">
                                    <h2 class="abs-centered z-1000 text-white mb-0 fs-30"><%= hizmet.kart_baslik || hizmet.baslik %></h2>
                                    <img loading="lazy" decoding="async" src="/static/assets/uploads/<%= hizmet.resim %>" class="img-fluid" alt="<%= hizmet.resim_alt %>">
                                    <div class="de-overlay-gradient-2"></div>
                                </a>
                                <div class="padding40 bg-white relative">
                                    <img src="/static/images/svg-color/air-conditioner-svgrepo-com.svg"
                                        class="w-70px p-2 bg-white abs abs-center rounded-1 mt-70" alt="">
                                    <p class="no-bottom"><%= hizmet.aciklama %></p>
                                    <div class="spacer-20"></div>
                                    <a class="btn-main w-100" href="/<%= hizmet.slug %>" aria-label="<%= hizmet.baslik %> hakkında bilgi"><%= hizmet.baslik %> Hakkında</a>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>

                    <div class="icerik mt-4">
<%- include('partials/ara-kutusu') %>
                    </div>
                </div>
            </section>
            <style>
                section.bg-light img.img-fluid {
                    width: 100%;
                    height: 250px; /* sabit yükseklik */
                    object-fit: cover; /* orantılı kırpma */
                    display: block;
                }
            </style>

<%- include('partials/cta') %>
        </div>
        <!-- content close -->
<%- include('partials/footer') %>
</body>

</html>
