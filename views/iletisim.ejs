<!DOCTYPE html>
<html lang="tr">

<head>
<%- include('partials/head') %>
<%- include('partials/sayfa-stil') %>
</head>

<body>
<%- include('partials/header') %>
        <!-- content begin -->
        <div class="no-bottom no-top" id="content">
            <div id="top"></div>
<%- include('partials/subheader', { arkaplan: '/static/images/background/8.webp', rozet: 'İletişim', h1: page.h1, crumbs: page.crumbs }) %>

            <section class="pb-0">
                <div class="container">
                    <div class="icerik">
                        <h2 class="mt-0"><%= iletisim.firma_adi %></h2>
                        <ul class="list-unstyled">
                            <li><i class="icofont-location-pin me-2 id-color"></i><strong>Adres:</strong> <address class="d-inline"><%= iletisim.adres %></address></li>
                            <li><i class="icofont-phone me-2 id-color"></i><strong>Telefon ve WhatsApp:</strong> <a href="tel:<%= iletisim.telefon %>"><%= telGoster(iletisim.telefon) %></a></li>
                            <li><i class="icofont-wall-clock me-2 id-color"></i><strong>Çalışma saatleri:</strong> <%= iletisim.calisma_saatleri %></li>
                            <li><i class="icofont-envelope me-2 id-color"></i><strong>E-posta:</strong> <a href="mailto:<%= iletisim.email %>"><%= iletisim.email %></a></li>
                        </ul>

<%- include('partials/ara-kutusu') %>
                    </div>
                </div>
            </section>

            <div style="margin: 30px;" class="maps">
                <iframe title="<%= iletisim.firma_adi %> konumu – Google Haritalar" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d188.19550045495484!2d28.838937148296335!3d41.000571353744384!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x61045d8aa7d10145:0x3b2ff94dc1368c7c!2sYenibosna%20F%C4%B1rt%C4%B1na%20Klima%20%26%20Kombi%20%7C%20Yenibosna%20Klima%20Tamir%20Bak%C4%B1m%20Montaj%20Servisi!5e0!3m2!1str!2sus!4v1765240146078!5m2!1str!2sus" width="100%" height="500" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>

<%- include('partials/cta') %>
        </div>
        <!-- content close -->
<%- include('partials/footer') %>
</body>

</html>
