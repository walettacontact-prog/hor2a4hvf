<%# Arama odaklı servis kutusu. Parametre: baslik (isteğe bağlı) %>
<div class="ara-kutusu">
    <p class="ara-kutusu-baslik"><%= locals.baslik || 'Servis için hemen arayın' %></p>
    <p class="ara-kutusu-metin"><%= iletisim.calisma_saatleri %> · Çoğu çağrıya aynı gün servis · Ücret işe başlamadan söylenir · Orijinal yedek parça · İşçilik garantisi</p>
    <div class="ara-kutusu-butonlar">
        <a class="ara-btn ara-btn-tel" href="tel:<%= iletisim.telefon %>"><i class="fa fa-phone"></i> <%= telGoster(iletisim.telefon) %></a>
        <% if (wa) { %>
        <a class="ara-btn ara-btn-wa" href="<%= wa %>" target="_blank" rel="noopener"><i class="fa fa-whatsapp"></i> WhatsApp’tan yazın</a>
        <% } %>
    </div>
</div>
