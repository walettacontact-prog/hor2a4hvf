    <!-- WhatsApp ve Telefon Butonları -->
    <% if (wa) { %>
    <a href="<%= wa %>" target="_blank" rel="noopener" class="whatsapp-float" title="WhatsApp" aria-label="WhatsApp ile yazın">
        <i class="fa fa-whatsapp"></i>
    </a>
    <% } %>

    <a href="tel:<%= iletisim.telefon %>" class="call-float" title="Ara" aria-label="Telefonla arayın">
        <i class="fa fa-phone"></i>
    </a>

    <style>
        /* WhatsApp Butonu */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 100px;
            /* telefon butonunun üstüne gelecek şekilde */
            right: 30px;
            background-color: #25D366;
            color: #fff;
            border-radius: 50%;
            text-align: center;
            font-size: 30px;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .whatsapp-float:hover {
            transform: scale(1.1);
        }

        /* Telefon Butonu */
        .call-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 30px;
            right: 30px;
            background-color: #007bff;
            color: #fff;
            border-radius: 50%;
            text-align: center;
            font-size: 28px;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .call-float:hover {
            transform: scale(1.1);
        }

        /* Mobil uyumlu ikon boyutları */
        @media(max-width:768px) {

            .whatsapp-float,
            .call-float {
                width: 50px;
                height: 50px;
                font-size: 24px;
            }
        }
    </style>
    <script>
        // Arama ve WhatsApp tıklamalarını Google Analytics'e dönüşüm olarak bildir
        document.addEventListener("click", function (e) {
            var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href*="wa.me/"]');
            if (!a || typeof gtag !== "function" || a.href.indexOf("905510319632") !== -1) return;
            var tel = a.href.indexOf("tel:") === 0;
            gtag("event", tel ? "telefon_arama" : "whatsapp_tiklama", { link_url: a.href, sayfa: location.pathname });
        });
    </script>
