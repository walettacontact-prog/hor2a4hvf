<% if (locals.heroPreload) { %>
    <!-- İlk slider görseli: sayfa açılır açılmaz insin (dikey ekranlarda kırpılmış küçük sürüm) -->
    <link rel="preload" as="image" href="/static/images/slider/5.webp" media="(min-aspect-ratio: 751/1000)" fetchpriority="high">
    <link rel="preload" as="image" href="/static/images/slider/5-mobile.webp" media="(max-aspect-ratio: 3/4)" fetchpriority="high">
    <style>
        .hero-bg-1 { background-image: url(/static/images/slider/5.webp); background-size: cover; background-repeat: no-repeat; }
        @media (max-aspect-ratio: 3/4) { .hero-bg-1 { background-image: url(/static/images/slider/5-mobile.webp); } }
    </style>
<% } %>
