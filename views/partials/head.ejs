    <style>
        /* JS yüklenmeden önceki görünüm yüklendikten sonrakiyle aynı olsun */
        .jarallax:has(.jarallax-img) { position: relative; z-index: 0; }
        .jarallax > .jarallax-img { position: absolute; object-fit: cover; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; }
        /* jarallax (hız 0.5) görseli bölüm + ekran yüksekliğinin yarısı kadar uzatır; JS gelince kırpım değişmesin */
        #subheader.jarallax:has(> .jarallax-img) { overflow: hidden; }
        #subheader.jarallax > .jarallax-img { height: calc(50% + 50vh); }
        @media (max-width: 993px) { header:not(.header-mobile) #mainmenu { display: none; } }
        /* Logo boyutu sabitlendi */
        #logo img { max-width: 130px; height: auto; display: inline-block; margin: 10px; }
        /* Hizmet kartı başlıkları h3 -> h2 oldu; eski h3 görünümünü koru */
        h2.abs-centered.fs-30 { line-height: 1.4em; letter-spacing: normal; padding-bottom: 0; }
        /* Ana sayfa H1'i slider'ın ilk karesinde: uzun başlık telefonda da 3-4 satırı geçmesin, animasyonla gecikmesin */
        h1.slider-title.slider-h1 { font-size: clamp(32px, 3.6vw, 52px); line-height: 1.1; letter-spacing: -1px; }
        .swiper-slide-active h1.slider-title.slider-h1 { animation: none; }
        .slider-butonlar .btn-main { margin: 0 8px 10px 0; }
        /* Uzun sayfa başlıkları telefonda ilk ekranı doldurmasın */
        @media (max-width: 576px) { #subheader h1 { font-size: 32px; line-height: 1.15; } }
    </style>
