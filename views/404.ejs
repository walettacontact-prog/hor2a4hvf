<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Sayfa Bulunamadı | Fırtına Klima & Kombi</title>
    <script>
        // GitHub Pages sunucu tarafında yönlendirme yapamıyor; eski adresler burada yönlendirilir.
        (function () {
            var path = location.pathname;
            var lower = path.toLowerCase();
            // Eski Express sitesi büyük/küçük harf ve sondaki "/" farkını önemsemiyordu: /Hakkimizda/ -> /hakkimizda
            var clean = lower.replace(/\/+$/, "").replace(/\.html$/, "");
            var pages = <%- JSON.stringify(routes) %>;
            if (pages.indexOf(clean) !== -1 && clean !== path) location.replace(clean + location.search + location.hash);
        })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/static/images/brand/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link href="/static/css/bootstrap.min.css" rel="stylesheet" type="text/css">
    <style>
        @font-face { font-family: 'Manrope'; font-style: normal; font-weight: 200 800; font-display: swap; src: url(/static/fonts/manrope/manrope-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
        @font-face { font-family: 'Manrope'; font-style: normal; font-weight: 200 800; font-display: swap; src: url(/static/fonts/manrope/manrope-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
    </style>
    <link href="/static/css/style.css" rel="stylesheet" type="text/css">
    <link href="/static/css/colors/scheme-01.css" rel="stylesheet" type="text/css">
    <style>
        .notfound { min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 40px 16px; }
        .notfound img { max-width: 220px; height: auto; margin-bottom: 32px; }
        .notfound .kod { font-size: 72px; font-weight: 800; line-height: 1; margin-bottom: 8px; color: #0a2540; }
        .notfound h1 { font-size: 26px; margin-bottom: 24px; letter-spacing: normal; }
        .notfound .btn-main { margin: 6px; }
    </style>
</head>

<body>
    <main class="notfound">
        <div>
            <a href="/"><img src="/static/yataylogo.webp" alt="<%= iletisim.firma_adi %>"></a>
            <p class="kod">404</p>
            <h1>Aradığınız sayfa bulunamadı</h1>
            <a href="/" class="btn-main">Ana Sayfa</a>
            <a href="/hizmetler" class="btn-main">Hizmetlerimiz</a>
            <a href="/serviscagir" class="btn-main">Servis Çağır</a>
            <a href="/iletisim" class="btn-main">İletişim</a>
            <a href="tel:<%= iletisim.telefon %>" class="btn-main">Hemen Arayın: <%= telGoster(iletisim.telefon) %></a>
        </div>
    </main>
</body>

</html>
