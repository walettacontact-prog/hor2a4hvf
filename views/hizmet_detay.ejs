<!DOCTYPE html>
<html lang="tr">

<head>
    <title>Servis Çağır | Fırtına Klima & Kombi Teknik Servis</title>
    <link rel="icon" href="/static/images/icon.png" type="image/png" sizes="16x16">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- ✅ SEO Meta Tags -->
    <meta name="description"
        content="İstanbul Fırtına Teknik Servis: Klima bakımı, kombi servisi, montaj, gaz dolumu, VRF sistemleri ve HVAC çözümleri. 7/24 acil servis hizmeti ile profesyonel teknik destek.">
    <meta name="keywords"
        content="İstanbul klima servisi, klima bakımı, klima tamiri, klima montajı, klima gaz dolumu, kombi servisi, kombi bakımı, HVAC servisi, VRF sistemleri, acil klima servisi, endüstriyel klima, ofis klima servisi, Fırtına Teknik Servis, klima teknik servis İstanbul, klima bakım fiyatları, kombi arıza servisi, klima arıza servisi, İstanbul kombi ustası, İstanbul klima ustası, klima kurulumu, klima temizliği, Fırtına Teknik Servis İstanbul, klima servis firması, profesyonel klima servisi, klima bakım servisi, teknik servis İstanbul">
    <meta name="author" content="Fırtına Klima & Kombi">
    <meta name="robots" content="index, follow">
    <meta name="language" content="Turkish">
    <meta name="revisit-after" content="3 days">
    <meta name="geo.region" content="TR-34">
    <meta name="geo.placename" content="Bahçelievler, İstanbul">
    <meta name="geo.position" content="41.0029;28.8295">
    <meta name="ICBM" content="41.0029, 28.8295">

    <!-- ✅ Canonical (duplicate content önleme) -->
    <link rel="canonical" href="https://www.firtinaklima.com/serviscagir">

    <!-- ✅ Open Graph / Facebook -->
    <meta property="og:locale" content="tr_TR">
    <meta property="og:site_name" content="Fırtına Teknik Servis">
    <meta property="og:title" content="Fırtına Teknik Servis | İstanbul Klima, Kombi ve HVAC Servisi">
    <meta property="og:description"
        content="İstanbul’un profesyonel klima ve kombi teknik servisi. Klima montajı, bakım, tamir, HVAC çözümleri ve 7/24 acil servis hizmeti.">
    <meta property="og:image" content="https://www.firtinaklima.com/static/logo.png">
    <meta property="og:url" content="https://www.firtinaklima.com/serviscagir">
    <meta property="og:type" content="website">

    <!-- ✅ Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Fırtına Teknik Servis | İstanbul Klima, Kombi ve HVAC Servisi">
    <meta name="twitter:description"
        content="İstanbul’da klima, kombi ve HVAC sistemleri için profesyonel bakım, montaj ve tamir hizmeti. Fırtına Teknik Servis – 7/24 destek.">
    <meta name="twitter:image" content="https://www.firtinaklima.com/static/logo.png">
    <meta name="twitter:site" content="@firtinateknik">
    <meta name="twitter:creator" content="@firtinateknik">

    <!-- ✅ Structured Data (Google Rich Results) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Fırtına Klima & Kombi",
      "image": "https://www.firtinaklima.com/static/logo.png",
      "@id": "https://www.firtinaklima.com",
      "url": "https://www.firtinaklima.com",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Hürriyet, Gazi 1 Sk No:35",
        "addressLocality": "Bahçelievler",
        "postalCode": "34192",
        "addressCountry": "TR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 41.0029,
        "longitude": 28.8295
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      },
      "sameAs": [
        "https://www.instagram.com/firtinaklima"
      ]
    }
    </script>

    <!-- ✅ CSS Files -->
    <link href="/static/css/bootstrap.min.css" rel="stylesheet" type="text/css" id="bootstrap">
    <link href="/static/css/plugins.css" rel="stylesheet" type="text/css">
    <link href="/static/css/swiper.css" rel="stylesheet" type="text/css">
    <link href="/static/css/style.css" rel="stylesheet" type="text/css">
    <link href="/static/css/coloring.css" rel="stylesheet" type="text/css">
    <link id="colors" href="/static/css/colors/scheme-01.css" rel="stylesheet" type="text/css">
</head>

<body>
    <div id="wrapper">
        <div class="float-text show-on-scroll">
            <span><a href="#">Scroll to top</a></span>
        </div>
        <div class="scrollbar-v show-on-scroll"></div>
        
        <!-- page preloader begin -->
        <div id="de-loader"></div>
        <!-- page preloader close -->

        <!-- header begin -->
                <header class="transparent scroll-light has-topbar">
            <div style="background-color: black !important;" id="topbar">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="d-flex justify-content-between xs-hide">
                                <div class="header-widget d-flex">
                                    <% if(iletisim) { %>
                                        <div class="topbar-widget"><a href="tel:<%= iletisim.telefon %>"><i
                                                    class="icofont-phone"></i>
                                                <%= iletisim.telefon %>
                                            </a></div>
                                        <div class="topbar-widget"><a href="mailto:<%= iletisim.email %>"><i
                                                    class="icofont-envelope"></i>
                                                <%= iletisim.email %>
                                            </a></div>
                                        <div class="topbar-widget"><a href="#"><i class="icofont-wall-clock"></i>
                                                <%= iletisim.calisma_saatleri || 'Pzt - Cmt 08.00 - 20.00' %>
                                            </a></div>
                                        <% } else { %>
                                            <div class="topbar-widget"><a href="tel:+905321234567"><i
                                                        class="icofont-phone"></i>+90 532 123 45 67</a></div>
                                            <div class="topbar-widget"><a href="mailto:info@istanbulklimateknik.com"><i
                                                        class="icofont-envelope"></i>info@istanbulklimateknik.com</a>
                                            </div>
                                            <div class="topbar-widget"><a href="#"><i class="icofont-wall-clock"></i>Pzt
                                                    - Cmt 08.00 - 20.00</a></div>
                                            <% } %>
                                </div>

                                <div class="social-icons">
                                    <% if(iletisim) { %>
                                        <% if(iletisim.facebook) { %><a href="<%= iletisim.facebook %>"><i
                                                    class="fa-brands fa-facebook fa-lg"></i></a>
                                            <% } %>
                                                <% if(iletisim.instagram) { %><a href="<%= iletisim.instagram %>"><i
                                                            class="fa-brands fa-instagram fa-lg"></i></a>
                                                    <% } %>
                                                        <% if(iletisim.youtube) { %><a href="<%= iletisim.youtube %>"><i
                                                                    class="fa-brands fa-youtube fa-lg"></i></a>
                                                            <% } %>
                                                                <% if(iletisim.whatsapp) { %><a
                                                                        href="<%= iletisim.whatsapp %>"><i
                                                                            class="fa-brands fa-whatsapp fa-lg"></i></a>
                                                                    <% } %>
                                                                        <% } else { %>
                                                                            <a href="#"><i
                                                                                    class="fa-brands fa-facebook fa-lg"></i></a>
                                                                            <a href="#"><i
                                                                                    class="fa-brands fa-instagram fa-lg"></i></a>
                                                                            <a href="#"><i
                                                                                    class="fa-brands fa-youtube fa-lg"></i></a>
                                                                            <a href="#"><i
                                                                                    class="fa-brands fa-whatsapp fa-lg"></i></a>
                                                                            <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>

            <div class="container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="de-flex sm-pt10">
                            <div class="de-flex-col">
                                <!-- logo begin -->
                                <div id="logo" class="text-start">
                                    <a href="/">
                                        <img class="logo-main" src="/static/yataylogo.png"
                                            alt="Fırtına Klima & Kombi">
                                    </a>
                                </div>
                                <!-- logo close -->
                            </div>

                            <div class="de-flex-col header-col-mid">
                                <ul id="mainmenu">
                                    <li><a class="menu-item" href="/">Ana Sayfa</a></li>
                                    <li><a class="menu-item" href="/hakkimizda">Hakkımızda</a></li>

                                    <li><a class="menu-item" href="/hizmetler">Hizmetler</a>
                                        <ul>
                                            <% hizmetler.forEach(function(hizmet) { %>
                                                <li>
                                                    <a class="menu-item" href="/hizmetler">
                                                        <%= hizmet.baslik %>
                                                    </a>
                                                </li>
                                                <% }) %>
                                        </ul>
                                    </li>



                                    <li><a class="menu-item" href="/hizmetler">Bölgeler</a>
                                        <ul>
                                            <% teknikServis.forEach(function(bolge) { %>
                                            <li><a class="menu-item" href="/hizmetler"><%= bolge.bolge %></a></li>
                                            <% }) %>
                                        </ul>
                                    </li>

                                    <li><a class="menu-item" href="/iletisim">İletişim</a></li>
                                </ul>
                            </div>

                            <div class="de-flex-col">
                                <div class="menu_side_area">
                                    <a style="background-color: #dc1d2c;" href="/iletisim"
                                        class="btn-main bg-color-2">Servis Talebi Oluştur</a>
                                    <span id="menu-btn"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>





        </header>
        <!-- header close -->
        <!-- content begin -->
        <div class="no-bottom no-top" id="content">
            <div id="top"></div>
            <!-- section begin -->
            <section id="subheader" class="jarallax text-light">
                <img src="/static/images/background/4.webp" class="jarallax-img" alt="">
                <div class="container relative z-index-1000">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <div class="subtitle s2 bg-color text-light wow fadeInUp mb-2">Bize Ulaşın</div>
                            <h1>Servis Çağır</h1>
                            <ul class="crumb">
                                <li><a href="/">Anasayfa</a></li>
                                <li class="active">Servis Çağır</li>
                            </ul>
                        </div>
                        <div class="col-lg-6 text-lg-end">
                            <div class="fs-20 fw-600 no-bottom sm-hide">Fırtına Teknik Servis — Sorunlar karşısında hızımız fırtına, çözümlerimiz kalıcı.</div>
                        </div>
                    </div>
                </div>
                <div class="de-overlay"></div>
            </section>
            <!-- section close -->
        </div>
        <!-- content close -->




 <section style="background-color: rgb(219 27 42);" class="section-dark bg-color text-light pt40 pb40">
                <div class="container">
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-9">
                            <h3 class="mb-1">
                                <i class="icofont-check-circled fs-32 me-3 id-color-2"></i>
                                İstanbul’da Profesyonel Klima &amp; Kombi Servisi
                            </h3>
                            <p class="mb-0">Hızlı bakım, güvenilir onarım ve kaliteli montaj hizmetlerimizle evinizde
                                veya iş yerinizde konforu garanti ediyoruz.</p>
                        </div>

                        <div class="col-lg-3 text-lg-end text-start">
                            <a style="background-color: #183a60;" class="btn-main bg-color-2"
                                href="tel:<%= iletisim.telefon %>">Hemen Arayın</a>
                        </div>
                    </div>
                </div>
            </section>





        <!-- footer begin -->
<footer style="background-color: #1a3a60;" class="section-dark">
            <div class="container">
                <div class="row gx-5">
                    <!-- Logo ve Hakkımızda -->
                    <!-- Logo ve Hakkımızda -->
                    <div id="logo" class="col-lg-4 col-sm-6 text-center">
                        <img src="/static/logobeyaz.png" alt="Logo" class="footer-logo">

                        <div class="spacer-20"></div>
                        <p>İstanbul’da klima ve kombi alanında profesyonel hizmet sunuyoruz. Uzman teknisyenlerimiz,
                            evinizde veya iş yerinizde konfor ve güvenliği sağlamak için hızlı ve güvenilir çözümler
                            sunar.</p>

                        <div class="social-icons mb-sm-30">
                            <% if (iletisim.facebook) { %><a href="<%= iletisim.facebook %>"><i class="fa-brands fa-facebook-f"></i></a><% } %>
                            <% if (iletisim.twitter) { %><a href="<%= iletisim.twitter %>"><i class="fa-brands fa-x-twitter"></i></a><% } %>
                            <% if (iletisim.instagram) { %><a href="<%= iletisim.instagram %>"><i class="fa-brands fa-instagram"></i></a><% } %>
                            <% if (iletisim.youtube) { %><a href="<%= iletisim.youtube %>"><i class="fa-brands fa-youtube"></i></a><% } %>
                        </div>
                    </div>

                    <style>
                        /* Footer logosunu ortala */
                        #logo.text-center {
                            text-align: center;
                        }

                        #logo.text-center img.footer-logo {
                            display: inline-block;
                            max-width: 150px;
                            /* İsteğe göre boyutlandır */
                            height: auto;
                        }
                    </style>


                    <!-- Menüler -->
                    <div class="col-lg-4 col-sm-12 order-lg-1 order-sm-2">
                        <div class="row">
                            <div class="col-lg-6 col-sm-6">
                                <div class="widget">
                                    <h5>Şirket</h5>
                                    <ul>
                                        <li><a href="/">Anasayfa</a></li>
                                        <li><a href="/hakkimizda">Hakkımızda</a></li>
                                        <li><a href="/hizmetler">Hizmetler</a></li>
                                        <li><a href="/serviscagir">Bölgeler</a></li>
                                        <li><a href="/iletisim">İletişim</a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-6 col-sm-6">
                                <div class="widget">
                                    <h5>Hizmetlerimiz</h5>
                                    <ul>
                                        <% hizmetler.forEach(hizmet => { %>
                                            <li><a href="/serviscagir"><%= hizmet.baslik %></a></li>
                                        <% }) %>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- İletişim -->
                    <div class="col-lg-4 col-sm-6 order-lg-2 order-sm-1">
                        <div class="widget">
                            <h5 class="id-color-2">7/24 Acil Servis</h5>
                            <h2 style="font-size: 35px;" class="jarallax mb0 wow fadeInUp" data-wow-delay=".2s"><i
                                    class="icofont-phone-circle id-color-2"></i><%= iletisim.telefon %></h2>

                            <div class="spacer-20"></div>

                            <div class="fw-bold text-white"><i class="icofont-location-pin me-2 id-color-2"></i>Adres
                            </div>
                            <%= iletisim.adres %>
                            <div class="spacer-20"></div>

                            <div class="fw-bold text-white"><i class="icofont-envelope me-2 id-color-2"></i>Mail</div>
                            <%= iletisim.email %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="subfooter">
                <div class="container">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="de-flex">
                                <div class="de-flex-col">
                                    &copy; <%= new Date().getFullYear() %> - Fırtına Klima & Kombi
                                </div>
                                <ul class="menu-simple">
                                    <li><a href="https://wa.me/905510319632?text=Merhaba%2C%20bilgi%20almak%20istiyorum.">created by <span style="color:red;">Ensar Ocakçı</span></a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>

        <!-- footer close -->
    </div>

    <!-- Javascript Files
    ================================================== -->
    <script src="/static/js/plugins.js"></script>
    <script src="/static/js/designesia.js"></script>
    <script src="/static/js/swiper.js"></script>
    <script src="/static/js/custom-marquee.js"></script>
    <script src="/static/js/custom-swiper-1.js"></script>
    <style>
        /* Logo boyutu sabitlendi */
        #logo img {
            max-width: 130px;
            height: auto;
            display: inline-block;
            margin: 10px;
        }
    </style>
    <!-- WhatsApp ve Telefon Butonları -->
    <% if (iletisim.whatsapp) { %>
    <a href="<%= iletisim.whatsapp %>" target="_blank" class="whatsapp-float" title="WhatsApp">
        <i class="fa-brands fa-whatsapp"></i>
    </a>
    <% } %>

    <a href="tel:<%= iletisim.telefon %>" class="call-float" title="Ara">
        <i class="fa-solid fa-phone"></i>
    </a>

    <style>
        /* WhatsApp Butonu */
        .whatsapp-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 100px;
            /* telefon butonunun üstüne gelecek şekilde */
            right: 30px;
            background-color: #25D366;
            color: #fff;
            border-radius: 50%;
            text-align: center;
            font-size: 30px;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .whatsapp-float:hover {
            transform: scale(1.1);
        }

        /* Telefon Butonu */
        .call-float {
            position: fixed;
            width: 60px;
            height: 60px;
            bottom: 30px;
            right: 30px;
            background-color: #007bff;
            color: #fff;
            border-radius: 50%;
            text-align: center;
            font-size: 28px;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .call-float:hover {
            transform: scale(1.1);
        }

        /* Mobil uyumlu ikon boyutları */
        @media(max-width:768px) {

            .whatsapp-float,
            .call-float {
                width: 50px;
                height: 50px;
                font-size: 24px;
            }
        }
    </style>
   
</body>

</html>