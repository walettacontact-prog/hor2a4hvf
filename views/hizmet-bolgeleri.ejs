<!DOCTYPE html>
<html lang="tr">

<head>
<%- include('partials/head') %>
<%- include('partials/sayfa-stil') %>
</head>

<body>
<%- include('partials/header') %>
<% const s = bolgeSayfasi; %>
        <!-- content begin -->
        <div id="content" class="no-top no-bottom">
            <div id="top"></div>
<%- include('partials/subheader', { arkaplan: '/static/images/background/4.webp', rozet: 'Bölgeler', h1: page.h1, crumbs: page.crumbs }) %>

            <section>
                <div class="container">
                    <article class="icerik">
                        <% s.giris.forEach(function (p, i) { %>
                        <p<% if (i === 0) { %> class="giris"<% } %>><%- linkle(p) %></p>
                        <% }) %>

<%- include('partials/ara-kutusu', { baslik: 'Bölgenize servis için hemen arayın' }) %>

                        <% s.bolumler.forEach(function (b) { %>
                        <h2 id="<%= b.id %>"><%= b.baslik %></h2>
                        <% (b.paragraflar || []).forEach(function (p) { %><p><%- linkle(p) %></p><% }) %>
                        <% if (b.maddeler && b.maddeler.length) { %>
                        <ul>
                            <% b.maddeler.forEach(function (m) { %><li><%- linkle(m) %></li><% }) %>
                        </ul>
                        <% } %>
                        <% }) %>

                        <p><a href="<%= iletisim.harita %>" target="_blank" rel="noopener">Adresimizi Google Haritalar’da görün</a></p>

                        <% if (s.sss.length) { %>
                        <h2>Sık Sorulan Sorular</h2>
                        <% s.sss.forEach(function (q) { %>
                        <h3 class="sss-soru"><%= q.soru %></h3>
                        <p><%- linkle(q.cevap) %></p>
                        <% }) %>
                        <% } %>

<%- include('partials/ara-kutusu', { baslik: 'Klima veya kombiniz için servis çağırın' }) %>

                        <h2>Hizmetlerimiz</h2>
                        <p class="diger-hizmetler">
                            <% hizmetler.forEach(function (x) { %><a href="/<%= x.slug %>"><%= x.baslik %></a><% }) %>
                        </p>
                    </article>
                </div>
            </section>

<%- include('partials/cta') %>
        </div>
        <!-- content close -->
<%- include('partials/footer') %>
</body>

</html>
