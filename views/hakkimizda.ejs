<!DOCTYPE html>
<html lang="tr">

<head>
<%- include('partials/head') %>
</head>

<body>
<%- include('partials/header') %>
        <!-- content begin -->
        <div id="content" class="no-top no-bottom">
            <div id="top"></div>
<%- include('partials/subheader', { arkaplan: '/static/images/background/1.webp', rozet: 'Hakkımızda', h1: page.h1, crumbs: page.crumbs }) %>

            <section>
                <div class="container">
                    <div class="row gx-5 align-items-center">
                        <div class="col-lg-6">
                            <div class="subtitle wow fadeInUp mb-3">Hakkımızda</div>
                            <h2 class="wow fadeInUp" data-wow-delay=".2s"><%= hakkimizda[0].baslik %></h2>
                            <p style="white-space: pre-line;"><%= (hakkimizda[0].aciklama || "").trim() %></p>
                        </div>

                        <div class="col-lg-6">
                            <div class="text-center">
                                <img loading="lazy" decoding="async" width="750" height="750"
                                    src="<%= hakkimizda[0].resim ? '/static/assets/uploads/' + hakkimizda[0].resim : '/static/images/misc/9.webp' %>"
                                    class="img-fluid rounded-10 mb-4 wow zoomIn" alt="<%= hakkimizda[0].resim_alt || iletisim.firma_adi %>"
                                    style="width: 100%; max-height: 400px; object-fit: cover;">

                                <div class="row justify-content-center g-3">
                                    <div class="col-md-6 col-12">
                                        <div class="bg-color-2 text-light px-4 pt-3 pb-2 rounded-10 h-100">
                                            <div class="de_count wow fadeInUp">
                                                <h3>Aynı Gün</h3>
                                                <h4>Servis İmkânı</h4>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-12">
                                        <div class="bg-color text-light px-4 pt-3 pb-2 rounded-10 h-100">
                                            <div class="de_count wow fadeInUp">
                                                <h3>Garantili</h3>
                                                <h4>İşçilik</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

<%- include('partials/cta') %>
        </div>
        <!-- content close -->
<%- include('partials/footer') %>
</body>

</html>
